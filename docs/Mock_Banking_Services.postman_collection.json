		{
			"name": "1. MOI National ID Validation",
			"item": [
				{
					"name": "Validate NID - Success (Mona Samir, Adult)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "X-API-Key",
								"value": "{{apiKey}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"national_id\": \"29805150101023\",\n  \"full_name\": \"Mona Samir Abdelrahman\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/moi/validate",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "moi", "validate"]
						},
						"description": "Validates a valid adult Egyptian National ID. Expected: valid=true, 200 OK."
					}
				},
				{
					"name": "Validate NID - Underage (Minor < 21)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "X-API-Key",
								"value": "{{apiKey}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"national_id\": \"31204010102041\",\n  \"full_name\": \"Malak Hany Sobhy\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/moi/validate",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "moi", "validate"]
						},
						"description": "Validates a minor National ID (< 21 yo). Expected: valid=false, reasons=['UNDER_MINIMUM_AGE']."
					}
				},
				{
					"name": "Validate NID - Deceased (Digits 10-13 = 8888)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "X-API-Key",
								"value": "{{apiKey}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"national_id\": \"28001010188881\",\n  \"full_name\": \"Deceased Citizen\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/moi/validate",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "moi", "validate"]
						},
						"description": "Digits 10-13 = 8888 triggers DECEASED status. Expected: valid=false, status=DECEASED."
					}
				},
				{
					"name": "Validate NID - Blocked (Digits 10-13 = 9999)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "X-API-Key",
								"value": "{{apiKey}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"national_id\": \"28001010199991\",\n  \"full_name\": \"Blocked Citizen\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/moi/validate",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "moi", "validate"]
						},
						"description": "Digits 10-13 = 9999 triggers BLOCKED status."
					}
				},
				{
					"name": "Validate NID - Invalid Format / Checksum",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "X-API-Key",
								"value": "{{apiKey}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"national_id\": \"123456789\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/moi/validate",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "moi", "validate"]
						},
						"description": "Returns HTTP 400 Bad Request with INVALID_NATIONAL_ID."
					}
				},
				{
					"name": "List All Verifications",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-API-Key",
								"value": "{{apiKey}}",
